# DevPilot AI - Environment Configuration Example
# Copy this file to .env and fill in values if using live AWS Bedrock integration.
# If AWS credentials are NOT provided, DevPilot AI automatically runs in Deterministic Local Demo Mode.

# Server Port Configuration
PORT=4000
FRONTEND_PORT=5173

# Sample Workspace Configuration (Absolute or relative path to target project)
# Default is ./sample-project/checkout_service
SAMPLE_WORKSPACE_PATH=./sample-project/checkout_service

# AWS Bedrock Configuration (Optional - for real AWS AI Reasoning)
# Note: Never commit real credentials to Git!
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# AWS Bedrock Model Selection
# Recommended: anthropic.claude-3-5-sonnet-20241022-v2:0 or amazon.nova-pro-v1:0
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Execution Security
MAX_AGENT_STEPS=8
COMMAND_TIMEOUT_MS=15000
